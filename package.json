{
  "name": "statify-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces",
    "test:e2e": "playwright test --config=testing/e2e/playwright.config.ts",
    "test:load:sav": "k6 run load-tests/backend/sav-apis-test.js",
    "install:all": "npm install --workspaces",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "concurrently": "^8.2.2",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-testing-library": "^7.5.3",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "k6": "^0.0.0",
    "patch-package": "^8.0.1",
    "puppeteer-core": "25.12.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "jstat": "^1.9.6",
    "react-dropzone": "^14.3.8",
    "recharts": "^3.8.0"
  }
}
